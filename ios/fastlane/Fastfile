# ios/ で fastlane <lane> を実行する。Xcode プロジェクトは ios/project.yml から xcodegen で生成する (make ios-project と同じ)
require "tmpdir"

default_platform(:ios)

platform :ios do
  # 実機向けに Release でビルドし、TestFlight へアップロードする (審査への提出はしない)。
  # 前提: Apple Developer Program で com.bannzai.sokudoku を登録し、App Store Connect にアプリを作成してあること。
  # 認証は App Store Connect API キー (ASC_API_KEY_ID / ASC_API_KEY_ISSUER_ID / ASC_API_KEY_P8_BASE64。env-secret-registry の正準名) で行う。
  # 自動署名の証明書・プロファイルも同じキーで xcodebuild に作らせる (-allowProvisioningUpdates と authenticationKey*)
  lane :beta do
    key_id = ENV.fetch("ASC_API_KEY_ID")
    issuer_id = ENV.fetch("ASC_API_KEY_ISSUER_ID")
    key_content_base64 = ENV.fetch("ASC_API_KEY_P8_BASE64")
    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content_base64,
      is_key_content_base64: true
    )

    sh("cd .. && xcodegen generate")

    # xcodebuild の -authenticationKeyPath は .p8 のファイルを要求するため、一時ディレクトリに書き出し、終わったら消す
    Dir.mktmpdir do |dir|
      key_path = File.join(dir, "AuthKey_#{key_id}.p8")
      File.write(key_path, key_content_base64.unpack1("m"))

      # ビルド番号はリポジトリに書かず、TestFlight の最新のビルド番号 + 1 にする (アップロードのたびに project.yml を変えないため)。
      # 初回 (TestFlight にビルドが無い) は initial_build_number の 0 + 1 = 1 になる
      build_number = latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1

      build_app(
        project: "Sokudoku.xcodeproj",
        scheme: "Sokudoku",
        configuration: "Release",
        export_method: "app-store",
        output_directory: "build/fastlane",
        clean: true,
        xcargs: [
          "CURRENT_PROJECT_VERSION=#{build_number}",
          "-allowProvisioningUpdates",
          "-authenticationKeyPath #{key_path}",
          "-authenticationKeyID #{key_id}",
          "-authenticationKeyIssuerID #{issuer_id}"
        ].join(" "),
        export_xcargs: [
          "-allowProvisioningUpdates",
          "-authenticationKeyPath #{key_path}",
          "-authenticationKeyID #{key_id}",
          "-authenticationKeyIssuerID #{issuer_id}"
        ].join(" ")
      )
    end

    upload_to_testflight(
      api_key: api_key,
      # 外部テスターへの配布 (ベータ版の審査) は App Store Connect で人が決めるため、ビルドの処理の完了を待たない
      skip_waiting_for_build_processing: true
    )
  end
end
