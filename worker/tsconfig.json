{
  "compilerOptions": {
    "target": "ES2022",
    // Worker が使う fetch・Request・Response・AbortSignal・TextDecoder は Web 標準の API のため、DOM の型定義で検査する
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts"]
}
